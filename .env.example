AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
TOKEN_BUDGET=300000
CHANGE_TOKEN_LIMIT=100000
AGENT_MAX_STEPS=40
VERIFY_TIMEOUT_MS=8000
PORT=3000
CONSOLE_PORT=3002

# --- Optional: an OpenAI-compatible provider (OpenAI, Groq, a local server) instead of Anthropic ---
# Uncomment and change AI_PROVIDER / AI_MODEL above, then:
#   AI_PROVIDER=openai
#   AI_MODEL=llama-3.3-70b-versatile
#   AI_BASE_URL=https://api.groq.com/openai/v1
# AI_BASE_URL must be https (http only for a server on this computer, e.g. http://localhost:11434/v1).
# It is only allowed with AI_PROVIDER=openai. For a local server AI_API_KEY may stay empty.
